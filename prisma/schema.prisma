// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model User {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  birthDate       DateTime
  weight          Float
  height          Float?
  shortName       String?
  familyRole      String?
  imageKey        String?
  isPrimaryUser   Boolean          @default(false)
  medicalExpenses MedicalExpense[]
}

enum ExpenseType {
  Pharmacy
  DoctorVisit
  Procedure
  Dental
  MentalHealth
}

model MedicalExpense {
  id          String      @id @default(uuid())
  title       String
  amount      Float
  date        DateTime
  description String?
  type        ExpenseType
  userId      String
  user        User        @relation(fields: [userId], references: [id])
}
