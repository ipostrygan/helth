generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Auth {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model User {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  firstName          String?
  lastName           String?
  birthDate          DateTime
  weight             Float
  height             Float?
  familyRole         String?
  shortName          String?
  imageKey           String?
  isPrimaryUser      Boolean            @default(false)
  fullName           String?
  profileType        ProfileType        @default(Human)
  appointments       Appointment[]
  medicalExpenses    MedicalExpense[]
  selfCareActivities SelfCareActivity[]
  therapies          Therapy[]
}

model MedicalExpense {
  id            String       @id @default(uuid())
  title         String
  amount        Float
  date          DateTime
  description   String?
  type          ExpenseType
  userId        String
  therapyId     String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  therapy       Therapy?     @relation(fields: [therapyId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

model Therapy {
  id               String           @id @default(uuid())
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean          @default(true)
  userId           String
  relatedDocuments String[]
  appointments     Appointment[]
  medicalExpenses  MedicalExpense[]
  user             User             @relation(fields: [userId], references: [id])
}

model Appointment {
  id               String            @id @default(uuid())
  title            String
  description      String?
  date             DateTime
  type             AppointmentType
  status           AppointmentStatus @default(Scheduled)
  location         String?
  notes            String?
  relatedDocuments String[]
  userId           String
  therapyId        String?
  cost             Float
  specialistLink   String?
  specialistName   String?
  therapy          Therapy?          @relation(fields: [therapyId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  medicalExpenses  MedicalExpense[]
}

model SelfCareActivity {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String?
  medication  String
  dosage      String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

enum ProfileType {
  Human
  Animal
}

enum ExpenseType {
  Pharmacy
  DoctorVisit
  Procedure
  Dental
  MentalHealth
}

enum AppointmentType {
  GeneralPractitioner
  Specialist
  Dental
  MentalHealth
  Lab
  Imaging
  Emergency
  FollowUp
  Vaccination
  Other
}

enum AppointmentStatus {
  Scheduled
  Completed
}
