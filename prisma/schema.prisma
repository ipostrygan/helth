// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model User {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  birthDate       DateTime
  weight          Float
  height          Float?
  shortName       String?
  familyRole      String?
  imageKey        String?
  isPrimaryUser   Boolean          @default(false)
  medicalExpenses MedicalExpense[]
  therapies       Therapy[]
  appointments    Appointment[]
}

enum ExpenseType {
  Pharmacy
  DoctorVisit
  Procedure
  Dental
  MentalHealth
}

enum AppointmentType {
  GeneralPractitioner
  Specialist
  Dental
  MentalHealth
  Lab
  Imaging
  Emergency
  FollowUp
  Vaccination
  Other
}

model MedicalExpense {
  id          String      @id @default(uuid())
  title       String
  amount      Float
  date        DateTime
  description String?
  type        ExpenseType
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  therapyId   String?
  therapy     Therapy?    @relation(fields: [therapyId], references: [id])
}

model Therapy {
  id                String           @id @default(uuid())
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  therapistName     String?
  therapistInfoLink String?
  location          String?
  isActive          Boolean          @default(true)
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  medicalExpenses   MedicalExpense[]
  appointments      Appointment[]
}

model Appointment {
  id               String            @id @default(uuid())
  title            String
  description      String?
  date             DateTime
  endDate          DateTime?
  type             AppointmentType
  status           AppointmentStatus @default(Scheduled)
  doctorName       String?
  location         String?
  notes            String?
  relatedDocuments String[]
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  therapyId        String?
  therapy          Therapy?          @relation(fields: [therapyId], references: [id])
}

enum AppointmentStatus {
  Scheduled
  Completed
  Cancelled
  NoShow
}